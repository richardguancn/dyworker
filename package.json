  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-alpha.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.1.2",
    "dsh-context": "0.62.2",
    "dsh-office-tools": "1.0.5",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "6.4.3",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "node-llama-cpp": true
  },
  "build": {
    "appId": "com.maquesoft.dyworker.app",
    "productName": "DYWorker",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "dist/electron/host/**/*",
      "dist/electron/scripts/linux_computer_use.py",
      "dist/electron/scripts/macos_computer_use.js",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "output/electron",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.cjs",
    "files": [
      "dist/client/**/*",
      "dist/electron/**/*",
      "package.json",
      "builtin-plugins/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "artifactName": "dyworker-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/dyworker.svg",
      "artifactName": "dyworker-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "category": "Utility",
      "target": [
        "deb"
      ],
      "icon": "build/dyworker.svg",
      "maintainer": "DYWorker Team <support@dyworker.local>",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "dyworker-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "richardguancn",
      "repo": "dyworker",
      "releaseType": "release",
      "tagNamePrefix": "v"
    }
  }
}
