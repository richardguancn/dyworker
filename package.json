{
  "name": "dyworker",
  "productName": "DYWorker",
  "desktopName": "dyworker.desktop",
  "version": "0.1.22",
  "description": "面向办公用户的本地 AI 工作助手",
  "author": {
    "name": "麻雀软件科技（深圳）有限公司",
    "email": "guandengyu@gmail.com",
    "url": "https://www.maquesoft.com/"
  },
  "homepage": "https://github.com/richardguancn/dyworker",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:renderer": "tsc --noEmit && vite build",
    "test": "node --test \"tests/*.test.mjs\"",
    "verify": "npm run build:renderer && npm test",
    "test:packaged-renderer": "node --test tests/packaged-renderer.test.mjs",
    "test:desktop": "node --test tests/desktop-contract.test.mjs",
    "test:settings": "node --test tests/settings.test.mjs",
    "test:skills": "node --test tests/skills.test.mjs",
    "test:agent": "node --test tests/agent.test.mjs",
    "test:channels": "node --test tests/channels.test.mjs",
    "test:memory": "node --test tests/memory.test.mjs",
    "package": "npm run verify && electron-builder --dir --publish never",
    "package:mac": "npm run verify && electron-builder --mac dmg zip --publish never",
    "package:linux:arm64": "npm run verify && electron-builder --linux AppImage deb --arm64 --publish never",
    "package:windows:x64": "npm run verify && electron-builder --win --x64 --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "silk-wasm": "^3.7.1",
    "weixin-clawbot": "^1.0.0"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.1.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.7.2",
    "vite": "6.4.2",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "node-llama-cpp": true
  },
  "build": {
    "appId": "com.maquesoft.dyworker.app",
    "productName": "DYWorker",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "electron/scripts/linux_computer_use.py",
      "electron/scripts/macos_computer_use.js",
      "node_modules/node-llama-cpp/**"
    ],
    "directories": {
      "output": "output/electron",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.cjs",
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/dyworker.svg",
      "artifactName": "dyworker-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "category": "Utility",
      "target": [
        "deb"
      ],
      "icon": "build/dyworker.svg",
      "maintainer": "DYWorker Team <support@dyworker.local>",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "dyworker-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "richardguancn",
      "repo": "dyworker",
      "releaseType": "release",
      "tagNamePrefix": "v"
    }
  }
}