{
  "mcpServers": {
    "data": {
      "command": "./mcp/launch",
      "args": ["./mcp/launch.mjs"],
      "cwd": ".",
      "env_vars": [
        "CODEX_HOME",
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "XDG_CACHE_HOME",
        "DATA_FORMS_TIMEOUT_MS"
      ],
      "tool_timeout_sec": 1800
    }
  }
}
