  "interface": {
    "displayName": "Data",
    "shortDescription": "Answer questions with data",
    "longDescription": "Data helps you turn questions about your product or business into answers you can act on. Investigate what changed, explore the evidence, and turn findings into clear visuals and recommendations. Start with your own data or explore a sample dashboard and report.\n\n**Deep analysis, grounded in your data**\n\n- Bring advanced OpenAI intelligence to data science tasks, from exploring datasets to testing hypotheses and explaining results.\n- Ground answers in your company’s data across connected warehouses, BI tools, and business applications.\n- Use your company’s semantic layer for authoritative metric definitions and business logic maintained by your data experts.\n- Investigate changes in conversion, revenue, and retention. Review launch performance, compare results with your plan, and understand the drivers.\n- Check data quality, estimate opportunities, and keep sources, assumptions, and uncertainty visible.\n\n**Clear, interactive visuals**\n\n- Quick inline answers: Get a concise explanation with a chart or table directly in chat.\n- Dashboards: Build interactive dashboards to monitor performance, explore trends, and investigate your business.\n- Reports: Turn findings into business reviews, reports, and presentations with clear takeaways and supporting evidence.\n\n**Works with your data and applications**\n\n- Bring data from warehouses, BI tools, product analytics platforms, spreadsheets, and uploaded files.\n- Work with your existing BI tools, Google Docs, and Microsoft Office to analyze data and create outputs in familiar formats.\n- Build interactive dashboards and reports with OpenAI Sites, and organize and share findings in OpenAI Pages.\n- Create reproducible notebooks and reuse metric definitions, reporting examples, and preferences as Data context for you or your team.",
    "developerName": "OpenAI",
    "category": "Data & Analytics",
    "capabilities": [
      "Interactive",
      "Read",
      "Write"
    ],
    "websiteURL": "https://openai.com/",
    "supportURL": "https://help.openai.com/",
    "privacyPolicyURL": "https://openai.com/policies/privacy-policy/",
    "termsOfServiceURL": "https://openai.com/policies/terms-of-use/",
    "defaultPrompt": [
      "Help me get started with my first data task",
      "Analyze product or business data and recommend where to focus next",
      "Turn my metric links and working preferences into reusable Data context"
    ],
    "brandColor": "#0285FF",
    "composerIcon": "./assets/datascience-small.svg",
    "logo": "./assets/datascience.png",
    "screenshots": []
  },
