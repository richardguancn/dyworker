{
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "pid": {
      "$ref": "#/$defs/__schema0"
    },
    "window_id": {
      "$ref": "#/$defs/__schema1"
    },
    "screenshot": {
      "$ref": "#/$defs/__schema2"
    },
    "accessibility": {
      "$ref": "#/$defs/__schema3"
    },
    "max_nodes": {
      "$ref": "#/$defs/__schema4",
      "description": "Maximum accessibility nodes per capture; increase for large windows."
    },
    "steps": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "pid",
    "window_id",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "default": true,
      "type": "boolean"
    },
    "__schema3": {
      "default": true,
      "type": "boolean"
    },
    "__schema4": {
      "default": 500,
      "description": "Maximum accessibility nodes per capture; increase for large windows.",
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "click"
            },
            "path": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema8"
              },
              "description": "Local filesystem path used by this operation."
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scroll"
            },
            "path": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              },
              "description": "Local filesystem path used by this operation."
            },
            "direction": {
              "type": "string",
              "enum": [
                "increment",
                "decrement"
              ],
              "description": "Direction in which to traverse or compare relationships."
            }
          },
          "required": [
            "kind",
            "path",
            "direction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "key-entry"
            },
            "path": {
              "maxItems": 32,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema10"
              },
              "description": "Local filesystem path used by this operation."
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "wait"
            },
            "milliseconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180000,
              "description": "Wait duration in milliseconds, within the 180-second operation deadline."
            }
          },
          "required": [
            "kind",
            "milliseconds"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema9": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema10": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "examples": [
    {
      "pid": 123,
      "window_id": 456,
      "steps": [
        {
          "kind": "wait",
          "milliseconds": 100
        }
      ]
    }
  ]
}
